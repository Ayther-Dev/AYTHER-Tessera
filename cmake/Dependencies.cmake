include_guard(GLOBAL)

function(tessera_load_dependencies)
    set(lock_path "${PROJECT_SOURCE_DIR}/cmake/dependencies.lock.json")
    file(READ "${lock_path}" dependency_lock)
    string(JSON dependency_count LENGTH "${dependency_lock}" dependencies)
    if(NOT dependency_count EQUAL 3)
        message(FATAL_ERROR "DEPENDENCY_LOCK_INVALID: exactly the three approved auxiliary dependencies are required.")
    endif()
    math(EXPR last_dependency "${dependency_count} - 1")
    foreach(index RANGE 0 ${last_dependency})
        string(JSON dependency_name GET "${dependency_lock}" dependencies ${index} name)
        string(JSON include_directory GET "${dependency_lock}" dependencies ${index} include_directory)
        string(JSON file_count LENGTH "${dependency_lock}" dependencies ${index} files)
        math(EXPR last_file "${file_count} - 1")
        foreach(file_index RANGE 0 ${last_file})
            string(JSON relative_path GET "${dependency_lock}" dependencies ${index} files ${file_index} path)
            string(JSON expected_hash GET "${dependency_lock}" dependencies ${index} files ${file_index} sha256)
            set(local_path "${PROJECT_SOURCE_DIR}/${relative_path}")
            if(NOT EXISTS "${local_path}")
                message(FATAL_ERROR "DEPENDENCY_CACHE_MISSING: ${relative_path}. Run tools/bootstrap-dependencies.ps1 -Download explicitly; configure never downloads.")
            endif()
            file(SHA256 "${local_path}" actual_hash)
            if(NOT actual_hash STREQUAL expected_hash)
                message(FATAL_ERROR "DEPENDENCY_HASH_MISMATCH: ${relative_path}. The cache must match the tracked lock.")
            endif()
        endforeach()
        if(dependency_name STREQUAL "nlohmann/json")
            set(target tessera_json)
            set(alias nlohmann_json::nlohmann_json)
        elseif(dependency_name STREQUAL "PicoSHA2")
            set(target tessera_picosha2)
            set(alias PicoSHA2::PicoSHA2)
        elseif(dependency_name STREQUAL "doctest")
            set(target tessera_doctest)
            set(alias doctest::doctest)
        else()
            message(FATAL_ERROR "DEPENDENCY_NOT_APPROVED: ${dependency_name}")
        endif()
        add_library(${target} INTERFACE)
        add_library(${alias} ALIAS ${target})
        target_include_directories(${target} SYSTEM INTERFACE "${PROJECT_SOURCE_DIR}/${include_directory}")
    endforeach()
endfunction()
