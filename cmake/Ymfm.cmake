include_guard(GLOBAL)

# ymfm (BSD-3-Clause) provides the YM2612/YM3438 of the native Mega Drive core
# (spec 008, DA-4, TP-107.1). Its sources are pinned in
# cmake/dependencies.lock.json (`component_sources`, name ymfm) and cached under
# third_party/cache by tools/bootstrap-dependencies.ps1. Configure verifies every
# file against the lock and never downloads.
function(tessera_add_ymfm)
    set(lock_path "${PROJECT_SOURCE_DIR}/cmake/dependencies.lock.json")
    file(READ "${lock_path}" lock)
    string(JSON count LENGTH "${lock}" component_sources)
    set(found FALSE)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${lock}" component_sources ${index} name)
        if(NOT name STREQUAL "ymfm")
            continue()
        endif()
        set(found TRUE)
        string(JSON include_dir GET "${lock}" component_sources ${index} include_directory)
        string(JSON file_count LENGTH "${lock}" component_sources ${index} files)
        math(EXPR last_file "${file_count} - 1")
        foreach(file_index RANGE 0 ${last_file})
            string(JSON relative GET "${lock}" component_sources ${index} files ${file_index} path)
            string(JSON expected GET "${lock}" component_sources ${index} files ${file_index} sha256)
            if(NOT EXISTS "${PROJECT_SOURCE_DIR}/${relative}")
                message(FATAL_ERROR "DEPENDENCY_CACHE_MISSING: ${relative}. Run tools/bootstrap-dependencies.ps1 -Download explicitly; configure never downloads.")
            endif()
            file(SHA256 "${PROJECT_SOURCE_DIR}/${relative}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "DEPENDENCY_HASH_MISMATCH: ${relative}. The cache must match the tracked lock.")
            endif()
        endforeach()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "DEPENDENCY_LOCK_INVALID: ymfm is missing from component_sources.")
    endif()

    set(root "${PROJECT_SOURCE_DIR}/${include_dir}")
    add_library(tessera_ymfm STATIC "${root}/ymfm_opn.cpp" "${root}/ymfm_adpcm.cpp" "${root}/ymfm_ssg.cpp"
        "${PROJECT_SOURCE_DIR}/src/md/ymfm_instantiate.cpp")
    target_include_directories(tessera_ymfm SYSTEM PUBLIC "${root}")
    if(MSVC)
    target_compile_options(tessera_ymfm PRIVATE /W0)
else()
    target_compile_options(tessera_ymfm PRIVATE -w)
endif()
    set_target_properties(tessera_ymfm PROPERTIES POSITION_INDEPENDENT_CODE ON)
    add_library(Tessera::ymfm ALIAS tessera_ymfm)
endfunction()
