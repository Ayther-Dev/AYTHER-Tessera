include_guard(GLOBAL)

function(tessera_check_toolchain)
    if(NOT WIN32 OR NOT CMAKE_HOST_WIN32 OR NOT MSVC)
        message(FATAL_ERROR "WINDOWS_MSVC_ABI_REQUIRED: use Windows and MSVC or clang-cl with the MSVC ABI.")
    endif()
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
        message(FATAL_ERROR "X64_TARGET_REQUIRED: the target pointer size must be 64 bits.")
    endif()
    if(NOT "$ENV{VSCMD_ARG_HOST_ARCH}" STREQUAL "x64" OR NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "x64")
        message(FATAL_ERROR "X64_DEVSHELL_REQUIRED: run tools/check.ps1 to import the x64 host/target Developer Shell.")
    endif()
    if(NOT "$ENV{VisualStudioVersion}" MATCHES "^18\\.")
        message(FATAL_ERROR "VS18_REQUIRED: Visual Studio 2026 (18.x) Developer Shell is required.")
    endif()
    if("$ENV{VCToolsVersion}" STREQUAL "" OR "$ENV{VCToolsVersion}" VERSION_LESS "14.51")
        message(FATAL_ERROR "MSVC_V145_REQUIRED: MSVC tools 14.51 or newer are required.")
    endif()
    if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
        message(FATAL_ERROR "NINJA_REQUIRED: use one of the approved Ninja presets.")
    endif()
    message(STATUS "Toolchain: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}; MSVC tools $ENV{VCToolsVersion}; host/target x64; CRT /MD")
endfunction()
