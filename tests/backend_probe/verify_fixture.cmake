cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED GENERATOR_EXECUTABLE OR NOT EXISTS "${GENERATOR_EXECUTABLE}")
    message(FATAL_ERROR "FIXTURE_GENERATOR_MISSING: provide the built fixture generator.")
endif()
if(NOT DEFINED OUTPUT_ROOT OR OUTPUT_ROOT STREQUAL "")
    message(FATAL_ERROR "FIXTURE_OUTPUT_REQUIRED: provide a test output directory.")
endif()

set(first_directory "${OUTPUT_ROOT}/first")
set(second_directory "${OUTPUT_ROOT}/second")
foreach(output_directory IN ITEMS "${first_directory}" "${second_directory}")
    execute_process(
        COMMAND "${GENERATOR_EXECUTABLE}" --generate "${output_directory}"
        RESULT_VARIABLE generation_result
        OUTPUT_VARIABLE generation_output
        ERROR_VARIABLE generation_error
        TIMEOUT 15)
    if(NOT generation_result STREQUAL "0")
        message(FATAL_ERROR "FIXTURE_GENERATION_FAILED: ${generation_result}: ${generation_error}")
    endif()
endforeach()

set(expected_files
    expected.json full-action.json full-control.json manifest.json
    program.md short-action.json short-control.json)
list(SORT expected_files)
file(GLOB first_files LIST_DIRECTORIES FALSE RELATIVE "${first_directory}" "${first_directory}/*")
file(GLOB second_files LIST_DIRECTORIES FALSE RELATIVE "${second_directory}" "${second_directory}/*")
list(SORT first_files)
list(SORT second_files)
if(NOT first_files STREQUAL expected_files OR NOT second_files STREQUAL expected_files)
    message(FATAL_ERROR "FIXTURE_ARTIFACT_SET_MISMATCH: generated files must match the declared set.")
endif()

foreach(relative_path IN LISTS expected_files)
    file(SHA256 "${first_directory}/${relative_path}" first_hash)
    file(SHA256 "${second_directory}/${relative_path}" second_hash)
    if(NOT first_hash STREQUAL second_hash)
        message(FATAL_ERROR "FIXTURE_NOT_REPRODUCIBLE: ${relative_path}")
    endif()
endforeach()

file(READ "${first_directory}/manifest.json" manifest)
string(JSON artifact_count LENGTH "${manifest}" artifacts)
if(NOT artifact_count EQUAL 6)
    message(FATAL_ERROR "FIXTURE_MANIFEST_INVALID: six non-manifest artifacts are required.")
endif()
foreach(artifact_index RANGE 0 5)
    string(JSON relative_path GET "${manifest}" artifacts ${artifact_index} path)
    string(JSON expected_hash GET "${manifest}" artifacts ${artifact_index} sha256)
    string(JSON expected_size GET "${manifest}" artifacts ${artifact_index} size_bytes)
    if(NOT relative_path IN_LIST expected_files OR relative_path STREQUAL "manifest.json")
        message(FATAL_ERROR "FIXTURE_MANIFEST_INVALID: unexpected artifact path.")
    endif()
    file(SHA256 "${first_directory}/${relative_path}" actual_hash)
    file(SIZE "${first_directory}/${relative_path}" actual_size)
    if(NOT actual_hash STREQUAL expected_hash OR NOT actual_size EQUAL expected_size)
        message(FATAL_ERROR "FIXTURE_MANIFEST_MISMATCH: ${relative_path}")
    endif()
endforeach()

file(SIZE "${first_directory}/program.md" rom_size)
file(READ "${first_directory}/program.md" rom_header OFFSET 0 LIMIT 272 HEX)
string(SUBSTRING "${rom_header}" 0 16 reset_vectors)
string(SUBSTRING "${rom_header}" 512 32 console_header)
if(NOT rom_size EQUAL 32768 OR NOT reset_vectors STREQUAL "00ffff0000000200"
        OR NOT console_header STREQUAL "53454741204d45474120445249564520")
    message(FATAL_ERROR "FIXTURE_ROM_HEADER_INVALID: size, reset vectors, or console signature differ.")
endif()

foreach(trace_name IN ITEMS short-action short-control full-action full-control)
    file(READ "${first_directory}/${trace_name}.json" trace)
    string(JSON frame_count LENGTH "${trace}" frames)
    if(trace_name MATCHES "^short-")
        set(expected_count 60)
        set(sample_indices 9 29 49)
    else()
        set(expected_count 3000)
        set(sample_indices 149 449 749)
    endif()
    if(NOT frame_count EQUAL expected_count)
        message(FATAL_ERROR "FIXTURE_TRACE_LENGTH_INVALID: ${trace_name}")
    endif()
    math(EXPR final_index "${expected_count} - 1")
    string(JSON first_frame GET "${trace}" frames 0 frame)
    string(JSON final_frame GET "${trace}" frames ${final_index} frame)
    if(NOT first_frame EQUAL 1 OR NOT final_frame EQUAL expected_count)
        message(FATAL_ERROR "FIXTURE_TRACE_BOUNDS_INVALID: ${trace_name}")
    endif()
    foreach(sample_position RANGE 0 2)
        list(GET sample_indices ${sample_position} sample_index)
        string(JSON control_count LENGTH "${trace}" frames ${sample_index} ports 0 controls)
        string(JSON button_b GET "${trace}" frames ${sample_index} ports 0 controls b)
        if(NOT control_count EQUAL 8)
            message(FATAL_ERROR "FIXTURE_TRACE_CONTROLS_INVALID: ${trace_name}")
        endif()
        if(trace_name MATCHES "-action$" AND sample_position EQUAL 1)
            if(NOT button_b)
                message(FATAL_ERROR "FIXTURE_ACTION_MISSING: ${trace_name}")
            endif()
        elseif(button_b)
            message(FATAL_ERROR "FIXTURE_UNEXPECTED_ACTION: ${trace_name}")
        endif()
    endforeach()
endforeach()
message(STATUS "FIXTURE_REPRODUCIBLE: both generations and declared input samples match.")
